# Top-most EditorConfig file
root = true

[*]
end_of_line = crlf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4

# --- Line Length Settings ---
# Set maximum line length to 120 (default is often 80 or 100)
max_line_length = 120

[*.cs]
# --- Whitespace & Formatting ---
csharp_new_line_before_open_brace = methods, properties, types
csharp_space_after_keywords_in_control_flow_statements = true

# --- Modern C# Syntax Preferences ---
# Enforce file-scoped namespaces (saves 1 level of indentation across all files)
csharp_style_namespace_declarations = file_scoped:warning

# Organize and trim unused 'using' directives
dotnet_separate_import_directive_groups = false
dotnet_sort_system_directives_first = true

# Disable forced primary constructors so standard multi-line constructors are allowed
csharp_style_prefer_primary_constructors = false:silent

# Allow standard block bodies for methods/constructors instead of forcing everything onto one short line
csharp_style_expression_bodied_methods = false:silent
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_properties = true:suggestion

# --- Type Clarity & Explicit Nullability ---
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Pattern matching preferences
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion

# --- Code Cleanliness & Warnings ---
dotnet_code_quality_unused_parameters = non_api:warning
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
