@model Application.Features.Account.Dto.EmailConfirmationEmailModel
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><title>Confirm your email</title></head>
<body style="font-family:Arial,sans-serif;color:#1f2937;line-height:1.5">
<h1>Confirm your email</h1><p>Hello @Model.RecipientName,</p><p>Please confirm that this email address belongs to you.</p>
<p>
    <a href="@Model.ConfirmationUrl" style="display:inline-block;padding:12px 20px;background:#2563eb;color:#fff;text-decoration:none;border-radius:6px">Confirm email</a>
</p>
<p>If you did not create this account, you can safely ignore this email.</p></body></html>
