@model Application.Features.Account.Dto.PasswordResetEmailModel
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><title>Reset your password</title></head>
<body style="font-family:Arial,sans-serif;color:#1f2937;line-height:1.5">
<h1>Reset your password</h1><p>Hello @Model.RecipientName,</p><p>Use the button below to choose a new password.</p>
<p><a href="@Model.ResetUrl" style="display:inline-block;padding:12px 20px;background:#2563eb;color:#fff;text-decoration:none;border-radius:6px">Reset password</a></p>
<p>If you did not make this request, you can safely ignore this email.</p></body></html>
